<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop desktop2 com rescap">

  <Identity
    Name="Allann.Intercom"
    Publisher="CN=Intercom Development"
    Version="1.0.0.35" />

  <Properties>
    <DisplayName>Intercom</DisplayName>
    <PublisherDisplayName>Intercom Development</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Extensions>
    <!-- Issue #36: package-scoped inbound exceptions for LAN discovery
         and the stable MVP control-channel port. Keep these restricted
         to Domain/Private profiles; Public networks must not expose a
         household intercom listener. -->
    <desktop2:Extension Category="windows.firewallRules">
      <desktop2:FirewallRules Executable="Intercom.App.exe">
        <desktop2:Rule
          Direction="in"
          IPProtocol="UDP"
          LocalPortMin="5353"
          LocalPortMax="5353"
          Profile="domainAndPrivate" />
        <desktop2:Rule
          Direction="in"
          IPProtocol="TCP"
          LocalPortMin="47811"
          LocalPortMax="47811"
          Profile="domainAndPrivate" />
        <desktop2:Rule
          Direction="in"
          IPProtocol="UDP"
          LocalPortMin="47810"
          LocalPortMax="47810"
          Profile="domainAndPrivate" />
        <desktop2:Rule
          Direction="in"
          IPProtocol="UDP"
          LocalPortMin="47812"
          LocalPortMax="47812"
          Profile="domainAndPrivate" />
      </desktop2:FirewallRules>
    </desktop2:Extension>
  </Extensions>

  <Applications>
    <Application
      Id="App"
      Executable="Intercom.App.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Intercom"
        Description="Local-first family intercom"
        BackgroundColor="transparent"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Square150x150Logo="Assets\Square150x150Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension
          Category="windows.startupTask"
          Executable="Intercom.App.exe"
          EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="IntercomStartupTask"
            Enabled="false"
            DisplayName="Intercom" />
        </desktop:Extension>

        <!-- Issue #25: registers this app as a target for native
             AppNotificationManager toast activation (Microsoft Learn's
             "Quickstart: Send and Handle App Notifications" — this manifest
             step is required even for a packaged/MSIX app like this one, not
             just unpackaged apps). See
             Intercom.App.AttentionCards.AttentionCardToastPresenter's class
             doc for the known Program.cs bootstrap-ordering caveat this
             registration is subject to. -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="8040678C-3DA5-4705-B15B-6EFBC4EBF409" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="Intercom.App.exe" DisplayName="Intercom" Arguments="----AppNotificationActivated:">
              <com:Class Id="8040678C-3DA5-4705-B15B-6EFBC4EBF409" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
