<Window
    x:Class="Intercom.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch">
        <Grid x:Name="RootShellGrid" Background="#FFF4E8CE" RequestedTheme="Light" Padding="16,20,24,32">
            <Grid.Resources>
                <Style x:Key="ComicButtonStyle" TargetType="Button">
                    <Setter Property="FontWeight" Value="Bold"/><Setter Property="Background" Value="#FFE8A33D"/>
                    <Setter Property="Foreground" Value="#FF2B1D14"/><Setter Property="BorderBrush" Value="#FF2B1D14"/>
                    <Setter Property="BorderThickness" Value="3"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14,8"/>
                </Style>
                <Style x:Key="SmallComicButtonStyle" TargetType="Button" BasedOn="{StaticResource ComicButtonStyle}">
                    <Setter Property="BorderThickness" Value="2"/><Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="Padding" Value="8,5"/><Setter Property="FontSize" Value="11"/>
                </Style>
                <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#FFB6502F"/>
                </Style>
                <Style x:Key="PanelStyle" TargetType="Border">
                    <Setter Property="Background" Value="#FFFBF4E4"/><Setter Property="BorderBrush" Value="#FF2B1D14"/>
                    <Setter Property="BorderThickness" Value="3"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="12"/>
                </Style>
            </Grid.Resources>

            <StackPanel Spacing="6" HorizontalAlignment="Stretch" VerticalAlignment="Top" Canvas.ZIndex="10" Margin="12">
                <InfoBar x:Name="CrashNotice" Title="Intercom closed unexpectedly last time" Message="Your settings are safe. Intercom has restarted and is available again." Severity="Warning" IsOpen="False" IsClosable="True"/>
                <InfoBar x:Name="PairingFailureNotice" Title="Couldn’t connect to that PC" Severity="Warning" IsOpen="False" IsClosable="True"/>
                <InfoBar x:Name="HotkeyNotice" Title="Push-to-talk shortcut unavailable" Severity="Warning" IsOpen="False" IsClosable="True"/>
                <InfoBar x:Name="IncomingAttentionNotice" Title="Attention card received" Severity="Informational" IsOpen="False" IsClosable="True"/>
                <InfoBar x:Name="UpdateNotice" Title="An update is available" Severity="Informational" IsOpen="False" IsClosable="True" CloseButtonClick="OnUpdateNoticeCloseButtonClick">
                    <InfoBar.ActionButton><Button x:Name="UpdateNoticeOpenReleaseButton" Content="View release" Click="OnUpdateNoticeOpenReleaseClick"/></InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

                <Grid VerticalAlignment="Stretch">
                    <Border Background="#FF2B1D14" CornerRadius="16"><Border.RenderTransform><TranslateTransform X="8" Y="8"/></Border.RenderTransform></Border>
                    <Border Background="#FFFBF4E4" BorderBrush="#FF2B1D14" BorderThickness="4" CornerRadius="16" Padding="20">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="📻 Intercom" FontSize="20" FontWeight="Bold" Foreground="#FF2B1D14" VerticalAlignment="Center"/>
                                <Button x:Name="SettingsButton" Content="⚙ Settings" Style="{StaticResource SmallComicButtonStyle}" HorizontalAlignment="Right" Click="OnSettingsClick"/>
                            </Grid>

                            <Grid x:Name="MainRegionsGrid" Grid.Row="1" ColumnSpacing="16" RowSpacing="14" VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="FamilyColumn" Width="210"/>
                                    <ColumnDefinition x:Name="VoiceColumn" Width="480"/>
                                    <ColumnDefinition x:Name="ChatColumn" Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="PrimaryRegionsRow" Height="*"/>
                                    <RowDefinition x:Name="SecondaryRegionsRow" Height="0"/>
                                    <RowDefinition x:Name="TertiaryRegionsRow" Height="0"/>
                                </Grid.RowDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="WideLayout">
                                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1050"/></VisualState.StateTriggers>
                                        </VisualState>
                                        <VisualState x:Name="MediumLayout">
                                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="840"/></VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="ChatPanel.(Grid.Row)" Value="1"/>
                                                <Setter Target="ChatPanel.(Grid.Column)" Value="0"/>
                                                <Setter Target="ChatPanel.(Grid.ColumnSpan)" Value="3"/>
                                                <Setter Target="ChatPanel.MinHeight" Value="360"/>
                                                <Setter Target="ChatColumn.Width" Value="0"/>
                                                <Setter Target="SecondaryRegionsRow.Height" Value="Auto"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="NarrowLayout">
                                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="FamilyPanel.(Grid.ColumnSpan)" Value="3"/>
                                                <Setter Target="VoicePanel.(Grid.Row)" Value="1"/>
                                                <Setter Target="VoicePanel.(Grid.Column)" Value="0"/>
                                                <Setter Target="VoicePanel.(Grid.ColumnSpan)" Value="3"/>
                                                <Setter Target="ChatPanel.(Grid.Row)" Value="2"/>
                                                <Setter Target="ChatPanel.(Grid.Column)" Value="0"/>
                                                <Setter Target="ChatPanel.(Grid.ColumnSpan)" Value="3"/>
                                                <Setter Target="ChatPanel.MinHeight" Value="360"/>
                                                <Setter Target="FamilyColumn.Width" Value="*"/>
                                                <Setter Target="VoiceColumn.Width" Value="0"/>
                                                <Setter Target="ChatColumn.Width" Value="0"/>
                                                <Setter Target="SecondaryRegionsRow.Height" Value="Auto"/>
                                                <Setter Target="TertiaryRegionsRow.Height" Value="Auto"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="FamilyPanel" Grid.Column="0" Style="{StaticResource PanelStyle}" Background="#FFF4E8CE" VerticalAlignment="Stretch">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="FAMILY" Style="{StaticResource SectionHeaderStyle}"/>
                                        <TextBlock x:Name="SelectedFamilyText" Text="Select who you want to reach" FontSize="10" Opacity="0.72" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="NoDiscoveredPeersNotice" Text="No family members yet." FontSize="11" Opacity="0.7"/>
                                        <StackPanel x:Name="DiscoveredPeersList" Spacing="8" MaxHeight="420"/>
                                        <Button Content="+ Add Family Member" Style="{StaticResource SmallComicButtonStyle}" Background="#FF2F6F6B" Foreground="#FFFBF4E4" HorizontalAlignment="Stretch" Click="OnAddFamilyMemberClick"/>
                                    </StackPanel>
                                </Border>

                                <Grid x:Name="VoicePanel" Grid.Column="1">
                                    <Grid.RowDefinitions><RowDefinition x:Name="GroupFloorRow" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Border x:Name="GroupFloorPanel" Grid.Row="0" Style="{StaticResource PanelStyle}" Background="#FFFFF8E8" Visibility="Collapsed">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="GROUP FLOOR" Style="{StaticResource SectionHeaderStyle}"/>
                                            <Grid>
                                                <TextBlock x:Name="GroupFloorSpeakerText" Text="● Nobody has the floor" FontSize="15" FontWeight="Bold"/>
                                                <TextBlock x:Name="GroupFloorCoordinatorText" Text="Start a floor to become coordinator" FontSize="11" Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel x:Name="GroupFloorQueuePanel" Orientation="Horizontal" Spacing="6" MinHeight="24"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="RaiseHandButton" Content="✋ Raise Hand" Style="{StaticResource SmallComicButtonStyle}" Click="OnRaiseHandClick"/>
                                                <Button x:Name="InterruptButton" Content="🚨 Interrupt" Style="{StaticResource SmallComicButtonStyle}" Background="#FFC1443A" Foreground="#FFFBF4E4" Click="OnInterruptClick"/>
                                                <Button x:Name="EndFloorButton" Content="End Session" Style="{StaticResource SmallComicButtonStyle}" Visibility="Collapsed" Click="OnEndFloorClick"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Background="#FFEAF3EE">
                                        <Grid RowSpacing="10">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="VOICE" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Top"/>
                                            <Grid Grid.Row="1" ColumnSpacing="14" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button x:Name="PushToTalkButton" Grid.Column="0" Width="90" Height="90" CornerRadius="45" Style="{StaticResource ComicButtonStyle}" Background="#FFB6502F" Foreground="#FFFBF4E4" IsEnabled="False" PointerReleased="OnPushToTalkReleased" PointerCanceled="OnPushToTalkReleased" PointerCaptureLost="OnPushToTalkReleased"><TextBlock Text="Hold to&#x0a;Talk" TextAlignment="Center"/></Button>
                                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                                    <ToggleSwitch x:Name="VoiceModeSwitch" Header="Speaking mode" OffContent="Hold to talk" OnContent="Toggle on/off" Toggled="OnVoiceModeToggled"/>
                                                    <ComboBox x:Name="HandsFreeRecipientCombo" Visibility="Collapsed" Width="210" PlaceholderText="Choose a family member" SelectionChanged="OnHandsFreeRecipientChanged"/>
                                                    <Button x:Name="HandsFreeButton" Visibility="Collapsed" IsEnabled="False" Click="OnHandsFreeClick"/>
                                                    <TextBlock x:Name="HandsFreeStatusText" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="PushToTalkHint" Text="Choose an online family member to talk." FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                                                    <Button x:Name="DndSignButton" Content="Available" Style="{StaticResource SmallComicButtonStyle}" HorizontalAlignment="Left" Click="OnToggleDndClick"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="● available" FontSize="10" Foreground="#FF5C8A52"/><TextBlock Text="● talking" FontSize="10" Foreground="#FFE8A33D"/><TextBlock Text="● DND" FontSize="10" Foreground="#FFC1443A"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border x:Name="ChatPanel" Grid.Column="2" Style="{StaticResource PanelStyle}" Background="#FFF4E8CE" VerticalAlignment="Stretch" MinWidth="220" AllowDrop="True" DragOver="OnChatDragOver" Drop="OnChatDrop">
                                    <Grid x:Name="ChatLayoutGrid" RowSpacing="8">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="CHAT" Style="{StaticResource SectionHeaderStyle}"/>
                                        <ComboBox Grid.Row="1" x:Name="ChatRecipientCombo" Visibility="Collapsed" PlaceholderText="Choose a family member" SelectionChanged="OnChatRecipientChanged"/>
                                        <StackPanel Grid.Row="2" Spacing="8">
                                            <CheckBox x:Name="SpokenChatCheckBox" Content="Read incoming messages aloud" Checked="OnSpokenChatToggled" Unchecked="OnSpokenChatToggled"/>
                                            <TextBlock x:Name="ChatChimeNotice" Text="🔔 New message" FontSize="11" FontWeight="Bold" Foreground="#FFB6502F" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="3" x:Name="ChatScrollViewer" MinHeight="250" MaxHeight="420"><StackPanel x:Name="ChatMessagesPanel" Spacing="6"/></ScrollViewer>
                                        <Grid x:Name="ChatComposerGrid" Grid.Row="4" RowSpacing="4">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" x:Name="ChatTypingText" Text="Typing…" FontSize="10" FontStyle="Italic" Visibility="Collapsed"/>
                                            <Border Grid.Row="1" x:Name="ChatAttachmentPreview" Background="#FFFFF8E8" BorderBrush="#FF2B1D14" BorderThickness="1" CornerRadius="8" Padding="6" Visibility="Collapsed">
                                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Image x:Name="ChatAttachmentThumbnail" Width="56" Height="56" Stretch="UniformToFill"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Image ready" FontWeight="Bold"/><TextBlock x:Name="ChatAttachmentDetails" FontSize="9"/></StackPanel>
                                                    <Button Grid.Column="2" Content="Remove" Click="OnRemoveChatAttachment"/>
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Row="2" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Button x:Name="ChatImageButton" Grid.Column="0" Content="🖼" ToolTipService.ToolTip="Share an image" Click="OnChooseChatImage"/>
                                                <Button x:Name="ChatEmojiButton" Grid.Column="1" Content="😊" ToolTipService.ToolTip="Insert emoji" Click="OnShowEmojiPicker"/>
                                                <TextBox x:Name="ChatInputBox" Grid.Column="2" PlaceholderText="Type Markdown…" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" KeyDown="OnChatInputKeyDown" TextChanged="OnChatInputChanged" Paste="OnChatPaste"/>
                                                <Button x:Name="ChatSendButton" Grid.Column="3" Content="Send" Style="{StaticResource SmallComicButtonStyle}" Background="#FF2F6F6B" Foreground="#FFFBF4E4" Click="OnChatSendClick"/>
                                            </Grid>
                                            <TextBlock Grid.Row="3" x:Name="ChatCharacterCount" HorizontalAlignment="Right" FontSize="9" Visibility="Collapsed"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid x:Name="AttentionRegionsGrid" Grid.Row="2" ColumnSpacing="16" RowSpacing="14" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="AttentionComposerColumn" Width="460"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="AttentionComposerRow" Height="0"/></Grid.RowDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="AttentionWideLayout">
                                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720"/></VisualState.StateTriggers>
                                        </VisualState>
                                        <VisualState x:Name="AttentionNarrowLayout">
                                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="AttentionComposerPanel.(Grid.Row)" Value="1"/>
                                                <Setter Target="AttentionComposerPanel.(Grid.Column)" Value="0"/>
                                                <Setter Target="AttentionComposerPanel.(Grid.ColumnSpan)" Value="2"/>
                                                <Setter Target="AttentionComposerColumn.Width" Value="0"/>
                                                <Setter Target="AttentionComposerRow.Height" Value="Auto"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Background="#FFF4E8CE">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="ATTENTION CARDS" Style="{StaticResource SectionHeaderStyle}"/>
                                        <TextBlock x:Name="NoAttentionCardsNotice" Text="No attention cards yet." FontSize="10" Opacity="0.7"/>
                                        <ScrollViewer x:Name="AttentionCardShelfScrollViewer" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" MinHeight="145" MaxHeight="175"><StackPanel x:Name="AttentionCardShelfPanel" Orientation="Horizontal" Spacing="14"/></ScrollViewer>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="AttentionComposerPanel" Grid.Column="1" Style="{StaticResource PanelStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="SEND AN ATTENTION CARD" Style="{StaticResource SectionHeaderStyle}"/>
                                        <TextBlock Text="Select an icon to send it" FontSize="10" Opacity="0.72"/>
                                        <ComboBox x:Name="ComposerRecipientCombo" Visibility="Collapsed" Width="140" PlaceholderText="Family member" SelectionChanged="OnAttentionRecipientChanged"/>
                                        <StackPanel x:Name="AttentionPresetButtonsPanel" Orientation="Horizontal" Spacing="8"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
        </Grid>
    </ScrollViewer>
</Window>
