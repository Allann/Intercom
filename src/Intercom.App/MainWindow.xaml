<Window
    x:Class="Intercom.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shell restyled to match intercom-integrated-prototype.html's "comic
         panel" look (thick ink borders, hard offset shadows, cream/paper/
         mustard/teal/rust palette, uppercase rust section headers) rather
         than plain default WinUI chrome — the earlier version only applied
         that palette to the chat/attention-card sections. RequestedTheme
         "Light" is set once at the root so every descendant (including
         InfoBar/ListView/ComboBox/TextBox defaults) gets consistent light-
         theme contrast without needing an explicit color on every single
         element, the same reasoning already used per-section before this
         pass. All existing x:Name values and event handlers are unchanged —
         only layout/styling moved. -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid Background="#FFF4E8CE" RequestedTheme="Light" Padding="24">
            <Grid.Resources>
                <!-- intercom-integrated-prototype.html's .comic-btn: bold,
                     thick ink border, rounded, mustard by default — callers
                     override Background/Foreground locally for the green/
                     red/teal variants, which always wins over this Style's
                     Setters. -->
                <Style x:Key="ComicButtonStyle" TargetType="Button">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Background" Value="#FFE8A33D" />
                    <Setter Property="Foreground" Value="#FF2B1D14" />
                    <Setter Property="BorderBrush" Value="#FF2B1D14" />
                    <Setter Property="BorderThickness" Value="3" />
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="Padding" Value="14,8" />
                </Style>
                <Style x:Key="SmallComicButtonStyle" TargetType="Button" BasedOn="{StaticResource ComicButtonStyle}">
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Padding" Value="8,5" />
                    <Setter Property="FontSize" Value="11" />
                </Style>
                <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Foreground" Value="#FFB6502F" />
                </Style>
                <Style x:Key="PanelStyle" TargetType="Border">
                    <Setter Property="Background" Value="#FFF4E8CE" />
                    <Setter Property="BorderBrush" Value="#FF2B1D14" />
                    <Setter Property="BorderThickness" Value="3" />
                    <Setter Property="CornerRadius" Value="12" />
                    <Setter Property="Padding" Value="12" />
                </Style>
            </Grid.Resources>

            <!-- Stretches to fill the window (up to a generous cap so text
                 lines don't get absurdly long on an ultra-wide monitor)
                 instead of centering a fixed-size block — this, plus the
                 star-sized shell-grid columns below, is what makes the shell
                 actually reactive to window resizing rather than clipping or
                 leaving dead space. -->
            <StackPanel Spacing="12" MaxWidth="1400" HorizontalAlignment="Stretch">

                <InfoBar
                    x:Name="CrashNotice"
                    Title="Intercom closed unexpectedly last time"
                    Message="Your settings are safe. Intercom has restarted and is available again."
                    Severity="Warning"
                    IsOpen="False"
                    IsClosable="True" />

                <!-- Issue #31: manual update check. Passive-only per ADR-0003 — no
                     download/install affordance, just detection + an honest "open
                     the release page in your browser" action. Dismissing persists
                     per-version (see MainWindow.OnUpdateNoticeCloseButtonClick) so it
                     doesn't reappear every launch, but a newer release than the
                     dismissed one will still surface a fresh notice. -->
                <InfoBar
                    x:Name="UpdateNotice"
                    Title="An update is available"
                    Severity="Informational"
                    IsOpen="False"
                    IsClosable="True"
                    CloseButtonClick="OnUpdateNoticeCloseButtonClick">
                    <InfoBar.ActionButton>
                        <Button x:Name="UpdateNoticeOpenReleaseButton" Content="View release" Click="OnUpdateNoticeOpenReleaseClick" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- "Window card" — the comic-panel shadow trick: a solid ink
                     Border sits behind the paper card, offset down-right via
                     RenderTransform (both stretch to the same size because
                     they share this Grid cell and default to Stretch
                     alignment), approximating the prototype's hard
                     "box-shadow: 8px 8px 0 ink" rather than a soft blur. -->
                <Grid>
                    <Border Background="#FF2B1D14" CornerRadius="16">
                        <Border.RenderTransform>
                            <TranslateTransform X="8" Y="8" />
                        </Border.RenderTransform>
                    </Border>
                    <Border Background="#FFFBF4E4" BorderBrush="#FF2B1D14" BorderThickness="4" CornerRadius="16" Padding="20">
                        <StackPanel Spacing="16">

                            <TextBlock Text="📻 Intercom" FontSize="20" FontWeight="Bold" Foreground="#FF2B1D14" />

                            <!-- ============ shell-grid: Family | center | Chat ============ -->
                            <!-- Star-sized (not fixed-pixel) columns with a
                                 MinWidth floor: the three rails scale
                                 proportionally as the window resizes instead
                                 of staying a fixed width regardless of the
                                 window, while never shrinking below a usable
                                 minimum (the outer ScrollViewer's horizontal
                                 scrollbar is the fallback below that). -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" MinWidth="190" />
                                    <ColumnDefinition Width="1.3*" MinWidth="220" />
                                    <ColumnDefinition Width="1.6*" MinWidth="260" />
                                </Grid.ColumnDefinitions>

                                <!-- - Family rail - -->
                                <Border Grid.Column="0" Style="{StaticResource PanelStyle}" VerticalAlignment="Top">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="FAMILY" Style="{StaticResource SectionHeaderStyle}" />

                                        <!-- Issue #20: visible-but-unapproved local peers only. No approve/
                                             connect action here — that's #21/#22. -->
                                        <TextBlock
                                            x:Name="NoDiscoveredPeersNotice"
                                            Text="No peers discovered yet."
                                            FontSize="11"
                                            Opacity="0.7" />
                                        <ListView x:Name="DiscoveredPeersList" MaxHeight="200" />

                                        <!-- Issue #22: Postcard Badges pairing ceremony + Rolodex, opened as
                                             a modal over the shell, per docs/mvp-specification.md §7. -->
                                        <Button
                                            x:Name="AddFamilyMemberButton"
                                            Content="+ Add Family Member"
                                            Style="{StaticResource ComicButtonStyle}"
                                            Background="#FF2F6F6B"
                                            Foreground="#FFFBF4E4"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Click="OnAddFamilyMemberClick" />
                                    </StackPanel>
                                </Border>

                                <!-- Center: Available/DND sign (the only real per-device
                                     status control until #26-#29's voice pipeline lands —
                                     the prototype's group-floor/hands-free/PTT panels have
                                     nothing to wire to yet) -->
                                <Border Grid.Column="1" Style="{StaticResource PanelStyle}" VerticalAlignment="Top">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="STATUS" Style="{StaticResource SectionHeaderStyle}" />

                                        <!-- Issue #23: the flippable Available/DND sign
                                             (intercom-shell-prototype.html's va-sign/vaToggleDnd), wired to
                                             the real, persisted DndSettingsStore via AttachPresence — not a
                                             mock toggle. Colors/text are set in code-behind (RenderDndSign)
                                             since they change at runtime; those local values always win
                                             over ComicButtonStyle's Setters below. -->
                                        <Button
                                            x:Name="DndSignButton"
                                            Content="Available"
                                            Style="{StaticResource ComicButtonStyle}"
                                            HorizontalAlignment="Left"
                                            Click="OnToggleDndClick" />

                                        <!-- Decorative legend, matching the prototype's va-tray strip. -->
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Border Width="12" Height="12" CornerRadius="4" Background="#FF5C8A52" BorderBrush="#FF2B1D14" BorderThickness="2" />
                                                <TextBlock Text="available" FontSize="10" Foreground="#FF2B1D14" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Border Width="12" Height="12" CornerRadius="4" Background="#FFC1443A" BorderBrush="#FF2B1D14" BorderThickness="2" />
                                                <TextBlock Text="DND" FontSize="10" Foreground="#FF2B1D14" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Chat rail -->
                                <!-- Issue #24: the chat drawer (intercom-shell-prototype.html's
                                     va-chat/va-msg), part of the same Console Panel shell per
                                     docs/mvp-specification.md §7. No live multi-peer connection roster
                                     exists in this app shell yet (the same gap #23's report flagged),
                                     so this drawer is wired to a real ChatService/ChatFrameCodec/
                                     FrameDispatcher pipeline running against an in-process
                                     LoopbackChatTransport pair standing in for a second device — see
                                     ChatDrawerDemo's doc comment. -->
                                <Border Grid.Column="2" Style="{StaticResource PanelStyle}" VerticalAlignment="Top">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="CHAT" Style="{StaticResource SectionHeaderStyle}" />
                                        <TextBlock
                                            Text="No second physical device is available in this environment, so this drawer runs a real send/receive/delivery-receipt pipeline against an in-process loopback stand-in for the peer's device."
                                            TextWrapping="Wrap"
                                            FontSize="10"
                                            Opacity="0.65"
                                            Foreground="#FF2B1D14" />

                                        <CheckBox
                                            x:Name="SpokenChatCheckBox"
                                            Content="Read incoming messages aloud (spoken chat)"
                                            Foreground="#FF2B1D14"
                                            Checked="OnSpokenChatToggled"
                                            Unchecked="OnSpokenChatToggled" />

                                        <TextBlock
                                            x:Name="ChatChimeNotice"
                                            Text="🔔 New message"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="#FFB6502F"
                                            Visibility="Collapsed" />

                                        <ScrollViewer x:Name="ChatScrollViewer" MaxHeight="220">
                                            <StackPanel x:Name="ChatMessagesPanel" Spacing="6" />
                                        </ScrollViewer>

                                        <!-- Grid instead of a horizontal StackPanel: the input
                                             box needs to actually grow with the column's
                                             available width (Star), not sit at a fixed pixel
                                             width — a StackPanel never stretches children along
                                             its own orientation. -->
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Name="ChatInputBox"
                                                Grid.Column="0"
                                                PlaceholderText="Type a message..."
                                                Foreground="#FF2B1D14"
                                                Background="#FFFBF4E4"
                                                KeyDown="OnChatInputKeyDown" />
                                            <Button
                                                x:Name="ChatSendButton"
                                                Grid.Column="1"
                                                Content="Send"
                                                Style="{StaticResource SmallComicButtonStyle}"
                                                Background="#FF2F6F6B"
                                                Foreground="#FFFBF4E4"
                                                Click="OnChatSendClick" />
                                        </Grid>

                                        <Button
                                            x:Name="SimulatePeerReplyButton"
                                            Content="Simulate peer reply"
                                            Style="{StaticResource SmallComicButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Click="OnSimulatePeerReplyClick" />
                                        <Button
                                            x:Name="SimulateDropButton"
                                            Content="Simulate connection drop (for in-flight sends)"
                                            Style="{StaticResource SmallComicButtonStyle}"
                                            Background="#FFC1443A"
                                            Foreground="#FFFBF4E4"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Click="OnSimulateDropClick" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ============ Attention cards + composer, side by side, spanning
                                 the full width — matches the prototype's .attention-row ============ -->
                            <!-- Issue #25: the attention-card shelf + composer
                                 (intercom-shell-prototype.html's va-shelf/composer), the same
                                 Console Panel shell per docs/mvp-specification.md §7. No live
                                 multi-peer connection roster/recipient list exists in this app
                                 shell yet (the same gap #22/#23/#24's reports flagged), so the
                                 recipient select below has exactly one demo entry and the
                                 send/receive/Ack pipeline runs against an in-process
                                 LoopbackAttentionCardTransport pair standing in for a second
                                 device — see MainWindow.InitializeAttentionCardShelf's doc. -->
                            <Border Style="{StaticResource PanelStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="ATTENTION CARDS" Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock
                                        Text="No second physical device is available in this environment, so this shelf runs a real send/receive/Delivered/Acknowledged pipeline against an in-process loopback stand-in for the peer's device. The recipient list below has exactly one demo entry for the same reason."
                                        TextWrapping="Wrap"
                                        FontSize="10"
                                        Opacity="0.65"
                                        Foreground="#FF2B1D14" />

                                    <TextBlock
                                        x:Name="NoAttentionCardsNotice"
                                        Text="No attention cards yet."
                                        FontSize="10"
                                        Opacity="0.7"
                                        Foreground="#FF2B1D14" />
                                    <ScrollViewer x:Name="AttentionCardShelfScrollViewer" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" MaxHeight="150">
                                        <StackPanel x:Name="AttentionCardShelfPanel" Orientation="Horizontal" Spacing="14" />
                                    </ScrollViewer>

                                    <!-- Grid instead of a horizontal StackPanel: the composer
                                         half (Star) grows with the panel's available width;
                                         the demo-controls half (Auto) stays natural-width. -->
                                    <Grid ColumnSpacing="16" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="8" MinWidth="280">
                                            <TextBlock Text="Send an attention card" FontWeight="Bold" FontSize="11" Foreground="#FF2B1D14" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <StackPanel Spacing="4" Width="200">
                                                    <TextBlock Text="Purpose" FontSize="9" FontWeight="Bold" Foreground="#FF2B1D14" />
                                                    <ComboBox
                                                        x:Name="ComposerPresetCombo"
                                                        Width="200"
                                                        Foreground="#FF2B1D14"
                                                        Background="#FFFBF4E4"
                                                        SelectionChanged="OnComposerPresetChanged" />
                                                    <TextBox
                                                        x:Name="ComposerCustomTextBox"
                                                        PlaceholderText="Type your own purpose…"
                                                        Visibility="Collapsed"
                                                        Foreground="#FF2B1D14"
                                                        Background="#FFFBF4E4" />
                                                </StackPanel>
                                                <StackPanel Spacing="4" Width="140">
                                                    <TextBlock Text="Send to" FontSize="9" FontWeight="Bold" Foreground="#FF2B1D14" />
                                                    <!-- Honest constraint (see the panel comment above):
                                                         exactly one demo recipient, no live roster yet. -->
                                                    <ComboBox
                                                        x:Name="ComposerRecipientCombo"
                                                        Width="140"
                                                        Foreground="#FF2B1D14"
                                                        Background="#FFFBF4E4"
                                                        SelectedIndex="0">
                                                        <x:String>The demo peer (loopback)</x:String>
                                                    </ComboBox>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Text="Icon (32x32 touch targets)" FontSize="9" FontWeight="Bold" Foreground="#FF2B1D14" Margin="0,4,0,0" />
                                            <StackPanel x:Name="EmojiPickerPanel" Orientation="Horizontal" Spacing="4" />

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                                <Button
                                                    x:Name="SendAttentionCardButton"
                                                    Content="Send"
                                                    Style="{StaticResource SmallComicButtonStyle}"
                                                    Background="#FF2F6F6B"
                                                    Foreground="#FFFBF4E4"
                                                    Click="OnSendAttentionCardClick" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                                            <TextBlock Text="Demo controls" FontWeight="Bold" FontSize="11" Foreground="#FF2B1D14" />
                                            <Button
                                                x:Name="SimulatePeerAttentionCardButton"
                                                Content="Simulate peer sends a card"
                                                Style="{StaticResource SmallComicButtonStyle}"
                                                Click="OnSimulatePeerAttentionCardClick" />
                                            <Button
                                                x:Name="SimulateAttentionCardDropButton"
                                                Content="Simulate connection drop (for in-flight sends)"
                                                Style="{StaticResource SmallComicButtonStyle}"
                                                Background="#FFC1443A"
                                                Foreground="#FFFBF4E4"
                                                Click="OnSimulateAttentionCardDropClick" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
