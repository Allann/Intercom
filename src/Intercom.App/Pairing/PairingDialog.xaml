<ContentDialog
    x:Class="Intercom.App.Pairing.PairingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Postcards From the Network"
    CloseButtonText="Close"
    DefaultButton="Close"
    Background="#FFF4E8CE"
    Foreground="#FF2B1D14"
    RequestedTheme="Light">

    <!-- Postcard Badges pairing flow (issue #7 prototype, ADR-0002, issue #22).
         Deliberately plain code-behind, no data-binding/MVVM infrastructure:
         the "card deck" and "Rolodex" panels below are populated and refreshed
         imperatively from PairingDialog.xaml.cs, the same convention
         MainWindow.UpdateDiscoveredPeers already uses.

         RequestedTheme="Light" plus explicit Foreground on every text element
         below: this dialog uses the fixed light "postcard" palette from
         pairing-ceremony-prototype.html (cream/paper/ink) regardless of the
         app's own light/dark theme, so its text must never depend on
         theme-inherited brushes — those default to a light color intended for
         dark surfaces and are unreadable against this dialog's cream
         background when the app is in dark mode. -->
    <ScrollViewer MaxHeight="560" MinWidth="480">
        <StackPanel Spacing="12" Padding="4">
            <TextBlock
                Text="Every discovered device arrives as an illustrated postcard. Match the wax seals, stamp it approved, or tear it up."
                TextWrapping="Wrap"
                Foreground="#FF2B1D14"
                Opacity="0.8"
                FontSize="12" />

            <Button
                x:Name="SimulateRequestButton"
                Content="Simulate a new pairing request"
                Click="OnSimulateRequestClick"
                Background="#FFE8A33D"
                Foreground="#FF2B1D14" />

            <TextBlock
                Text="No two real devices are available in this environment, so &quot;Simulate&quot; runs a real ceremony (real nonces, real transcript, real six-digit code, real IdentityStore.Approve) against an in-memory stand-in for the second device."
                TextWrapping="Wrap"
                Foreground="#FF2B1D14"
                Opacity="0.65"
                FontSize="11" />

            <TextBlock Text="Postcards" FontWeight="Bold" FontSize="16" Foreground="#FFB6502F" />
            <StackPanel x:Name="PostcardDeckPanel" Orientation="Horizontal" Spacing="12" />
            <TextBlock x:Name="NoPostcardsNotice" Text="No pairing requests in progress." Foreground="#FF2B1D14" Opacity="0.7" />

            <Rectangle Height="2" Fill="#FF2B1D14" Opacity="0.3" Margin="0,8,0,0" />

            <TextBlock Text="Rolodex — already approved" FontWeight="Bold" FontSize="16" Foreground="#FF1F4D4A" />
            <StackPanel x:Name="RolodexPanel" Spacing="8" />
            <TextBlock x:Name="NoApprovedPeersNotice" Text="No approved peers yet." Foreground="#FF2B1D14" Opacity="0.7" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
